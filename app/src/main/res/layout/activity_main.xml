<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1318">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B2027"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Polar H10 Android Recorder"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConnectBle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Connect BLE"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="⏺ Record"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tab Buttons Container -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#14181D">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button android:id="@+id/tab1Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Screen 1: Results" />
            <Button android:id="@+id/tab2Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Screen 2: HRV" />
            <Button android:id="@+id/tab3Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Screen 3: Activity" />
            <Button android:id="@+id/tab4Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Screen 4: Event Inspector" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Content Frame -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
