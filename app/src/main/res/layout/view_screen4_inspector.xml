<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Date Time Subheader -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="←" android:textSize="20sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="📅 2026-04-14 à 10:24:33 · 01 h 18 min 22 sec" android:textColor="#64748B" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textSize="20sp" />
        </LinearLayout>

        <!-- Inspector Event Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="VEB - Couplet (12/19)"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="2026-04-14 10:24:33"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <!-- Custom QRS Canvas View (Red Ectopic Couplet Highlights & Green Dots) -->
        <com.polar.recorder.ui.Screen4InspectorView.CustomQrsCanvasView
            android:id="@+id/customQrsCanvas"
            android:layout_width="match_parent"
            android:layout_height="180dp" />

        <!-- Filter Badge -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF7ED"
            android:textColor="#C2410C"
            android:padding="10dp"
            android:gravity="center"
            android:text="≡  VEB - Couplet"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Action Cards Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="#FFFFFF" android:padding="12dp" android:gravity="center" android:text="🔍\nLocate Extrasystoles" android:textColor="#0284C7" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_marginStart="6dp" android:text="≡\nMultiples" android:textColor="#C2410C" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_marginStart="6dp" android:text="📈\nECG signal" android:textColor="#0284C7" android:textStyle="bold" />
        </LinearLayout>

        <!-- Amplitude Buttons -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AMPLITUDE" android:textColor="#64748B" android:textStyle="bold" android:textSize="11sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="10dp">
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="✕" />
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="^" />
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="v" />
        </LinearLayout>

        <!-- Temporal Navigation -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEMPORAL NAVIGATION" android:textColor="#64748B" android:textStyle="bold" android:textSize="11sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔍" />
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔎" />
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="&lt;&lt;" />
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="&lt;" />
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="&gt;" />
            <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="&gt;&gt;" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
